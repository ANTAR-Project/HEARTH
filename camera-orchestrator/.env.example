# ============================================================
# camera-orchestrator — Environment Variables Template
# Copy this file to .env and fill in your real values.
# !! NEVER put real credentials in this file !!
# ============================================================

# --- Database ---
DB_PASSWORD=changeme

# --- MQTT Broker ---
MQTT_PASSWORD=changeme

# --- Camera (HTTP/ONVIF) ---
CAMERA_DEFAULT_IP=192.168.X.X
CAMERA_SUBNET=192.168.X.X/24
CAMERA_RTSP_USERNAME=admin
CAMERA_PASSWORD=changeme

# --- RTSP Stream (go2rtc) ---
RTSP_USERNAME=admin
RTSP_PASSWORD=changeme
RTSP_IP=192.168.X.X
RTSP_PORT=5543
