# ============================================================
# camera-orchestrator — Environment Variables Template
# Copy this file to .env and fill in your real values.
# !! NEVER put real credentials in this file !!
# ============================================================

# --- Server ---
SERVER_PORT=9008

# --- Database ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=homeassistant
DB_USER=ha_app
DB_PASSWORD=changeme

# --- MQTT Broker ---
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=ha_app
MQTT_PASSWORD=changeme

# --- External Services ---
GO2RTC_URL=http://go2rtc:1984
VIDEO_SERVICE_URL=http://video-service:9004
NAS_ORCHESTRATOR_URL=http://nas-orchestrator:9002
STREAMING_SERVICE_URL=http://streaming-service:9006

# --- Camera (HTTP/ONVIF) ---
CAMERA_DEFAULT_IP=192.168.X.X
CAMERA_SUBNET=192.168.X.X/24
CAMERA_RTSP_USERNAME=admin
CAMERA_PASSWORD=changeme

# --- RTSP Stream (go2rtc) ---
RTSP_USERNAME=admin
RTSP_PASSWORD=changeme
RTSP_IP=192.168.X.X
RTSP_PORT=5543
